# Copy this file to apps/api/.env and configure for your environment.
# Do NOT commit your actual .env file. It is listed in .gitignore.

# --- API server ---
PORT=4000

# Set a dedicated RPC endpoint for reliability under load.
# Without this, the public mainnet endpoint is used and WILL be rate-limited.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY_HERE

SOLANA_CLUSTER=mainnet-beta

# Set this to your frontend origin in production. NEVER use localhost in production.
CORS_ORIGIN=http://localhost:5173

# Maximum ms to wait for an individual RPC call before timing out.
REQUEST_TIMEOUT_MS=12000

# Set to "production" when running the compiled server in production.
NODE_ENV=development

# --- Frontend (Vite) ---
# Set this in apps/web/.env to tell the frontend where the API is hosted.
# In development, Vite proxies /api to localhost:4000 automatically.
# VITE_API_URL=https://your-api.onrender.com
